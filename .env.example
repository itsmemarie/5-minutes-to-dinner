# ── Frontend (Vite) ─────────────────────────────────────────────────
# Public values, bundled into the app. Set the same two in Vercel.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Server-side secrets (Supabase Edge Functions) ───────────────────
# Never VITE_-prefixed, so Vite never bundles them into client code. Keep them
# here only as a local note, and push them to Supabase with:
#   npx supabase secrets set --project-ref <ref> OWNER_EMAIL=... ANTHROPIC_API_KEY=... GROQ_API_KEY=...

# The account that gets the owner's AI (Claude + the model switcher).
OWNER_EMAIL=owner@example.com
# The owner's Claude key — used only for the owner's own requests.
# Optional (needs paid API credit; a Claude subscription does not work here). Without it the owner uses Groq.
# ANTHROPIC_API_KEY=your_anthropic_api_key
# The owner's Groq key — the free default AI for everyone else.
GROQ_API_KEY=your_groq_api_key
# Optional: the Gemini model users' own Google keys run on (default gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash
