VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-side only (read by Supabase Edge Functions via Deno.env.get) — never
# VITE_-prefixed, so Vite never bundles it into client code. Paste your key
# below, then push it to Supabase with:
#   npx supabase secrets set --project-ref <ref> GROQ_API_KEY="$(grep '^GROQ_API_KEY=' .env | cut -d= -f2-)"
GROQ_API_KEY=your_groq_api_key
